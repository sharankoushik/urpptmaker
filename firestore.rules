rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "koushiksharan.08@gmail.com";
    }
    match /orders/{id} {
      allow create: if false; // orders are created only by the trusted payment function
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /siteSettings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}